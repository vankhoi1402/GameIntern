    characterSetSelectionMode: 7
    characterSequence: "\uB2EC\uAC40\uC120\uBB3C\uAE38\uAC8C\uB20C\uB7EC\uBCF4\uB4DC\uBCF4\uAE30\uACC4\uC18D\uD50C\uB808\uC774\uD558\uB824\uBA74\uC2DC\uAC04\uCD94\uAC00\uC544\uBC14\uD0C0\uC800\uC7A5\uACC4\uC18D\uACE0\uAC1D\uC11E\uAE30\uC790\uC11D\uC0C8\uB85C\uACE0\uCE68\uB300\uAE30\uC911\uC778\uBAA8\uB4E0\uACE0\uAC1D\uC11E\uAE30\uACE0\uAC1D\uC74C\uC2DD\uC790\uB3D9\uC218\uC9D1\uBC14\uAD6C\uB2C8\uBAA8\uB4E0\uAC83\uC0C8\uB85C\uACE0\uCE68\uBD80\uC2A4\uD130\uAD6C\uB9E4\uBB34\uB8CC\uC694\uB9AC\uD558\uB098\uBC1B\uAE30?!\uC11C\uBE59\u66F4\u5FEB\uD558\uAC8C\uC694\uB9AC\uC2AC\uB86F\uD574\uC81C\uC138\uC77C60%\uD55C\uBC88\uB9CC!VIP\uB9CC\uB8CC\uC9C0\uAE08\uC7AC\uD65C\uC131\uD654\uD558\uC5EC\uD61C\uD0DD\uACC4\uC18D\uC288\uD37C\uD558\uB4DC\uB808\uBCA8\uD558\uB4DC\uB808\uBCA8\uC624\u2026\uBE48\uC811\uC2DC\uC5C6\uC74C!\uC624\uC774\uB7F0\u2026\uC2DC\uAC04\uCD08\uACFC!\uB808\uBCA8\uC644\uB8CC\uC5B4\uB824\uC6C0\uC288\uD37C\uD558\uB4DC\uC77C\uC77C\uC791\uC5C5\uAD11\uACE0\uC81C\uAC70\uC800\uAE08\uD1B5\uB7ED\uD0A4\uC2A4\uD540\uB808\uBCA8{level}\uC5D0\uC11C\uD574\uC81C\uB354\uB9CE\uC740\uBAA9\uC228\uBAA9\uC228\uC774\uB2E4\uB410\uC5B4\uC694\uB2E4\uC74C\uBAA9\uC228\uAE4C\uC9C0\uC2DC\uAC04\uBC1B\uAE30\uB9AC\uD544\uCF54\uC778\uBD80\uC871\uBAA9\uC228\uC774\uAC00\uB4DD\uCC28\uC9C0\uC54A\uC74C\uB808\uBCA8\uC2E4\uD328\uBCF4\uC0C1\uFF1A\uB2E4\uC2DC\uC2DC\uB3C4\uC77C\uC77C\uD018\uC2A4\uD2B8\uC77C\uC77C\uC791\uC5C5\uD018\uC2A4\uD2B8\uC791\uC5C5\uC218\uB839\uAC00\uAE30\uC0C8\uC694\uB9AC!\uC2E0\uADDC\uC774\uB3D9\uD69F\uC218\uCD08\uACFC\uACC4\uC18D\uD50C\uB808\uC774\uC704\uD574\uC694\uB9AC\uBC1B\uAE30\uC5EC\uAE30\uC11C\uC9C8\uBED4\uACC4\uC18D\uB3C4\uC804!\uC77C\uC2DC\uC815\uC9C0\uB9AC\uD50C\uB808\uC774\uD648\uC800\uAE08\uD1B5\uBD80\uC218\uACE0\uBAA8\uC740\uCF54\uC778\uAC00\uC838\uAC00!\uACE7\uCD9C\uC2DC\uBCF4\uC0C1\uAD11\uACE0\uB294\uC720\uC9C0\uD558\uACE0\uAD11\uACE0\uC81C\uAC70\uC0C1\uC810\uC81C\uC548\uCD08\uBCF4\uC790\uBC88\uB4E4\uAC00\uCE58\uBC88\uB4E4\uD6CC\uB96D\uD55C\uBC88\uB4E4\uD504\uB9AC\uBBF8\uC5C4\uBC88\uB4E4\uC6B8\uD2B8\uB77C\uBC88\uB4E4\uB808\uC804\uB4DC\uBC88\uB4E4\uCD5C\uACE0\uC81C\uC548\uC77CVIP\uD328\uC2A4\uC77C\uC77C+1\uC694\uB9AC\uAD11\uACE0\uC5C6\uC74C\uCF54\uC778\uC124\uC815VIP\uD65C\uC131\uD654VIP\uC694\uB9AC2\uC2DC\uAC04\uBB34\uB8CC!\uC77C\uC77C\uBCF4\uC0C1\uC2A4\uD540VIP\uC77C\uC77CVIP\uC694\uB9AC\uD574\uC81C2\uC2DC\uAC04\uBB34\uB8CC\uB85C\uBC1B\uAE30!\uD37C\uD399\uD2B8!x2\uCF54\uC778\uC644\uB8CC\uB808\uBCA8\uAD11\uACE0\uBCF4\uAE30\uBD80\uC2A4\uD130\uC0AC\uC6A9\uD68C\uC804\uC911!!!\uACE0\uAC1D\uC11C\uBE59\uBBFF\uC744\uC218\uC5C6\uC5B4!\uB180\uB77C\uC6CC!\uC7A5\uAD00\uC774\uC57C!\uACBD\uC774\uB85C\uC6CC!\uB6F0\uC5B4\uB098!\uBA4B\uC838!\uC13C\uC138\uC774\uC154\uB110!\uC7742\uAC1C\uAC00\uBC29\uC5D0\uC694\uB9AC\uAC00\uBD80\uC871\uD574\uB300\uAE30\uC5F4\uC5D0\uB354\uC774\uC0C1\uACE0\uAC1D\uC5C6\uC74C!\uAE30\uB2E4\uB9AC\uB294\uACE0\uAC1D\uC5C6\uC74C!\uC0AC\uC6A9\uD560\uC218\uC5C6\uC74C\uBA4B\uC838!\uC774\uC81C\uC2DC\uC791\uD560\uC900\uBE44\uB410\uC5B4.\uAD6C\uB9E4\uC2E4\uD328\uACE0\uB9C8\uC6CC\uC694!\uAD11\uACE0\uC900\uBE44\uC548\uB428\uD558\uD2B8\uAC00\uB4DD\uCC3C\uC5B4\uC694\uC21C\uC11C\uC544\uB2D8\uBAA9\uC2281\uAC1C\uB97C\uC783\uC2B5\uB2C8\uB2E4\uB124\uBCF4\uC0C1\uAD6C\uB9E4\uC778\uAE30\uC5B8\uC5B4\uC544\uC9C1\uD64D\uD569\uD30C\uC2A4\uD0C0\uCC38\uCE58\uC2A4\uD14C\uC774\uD06C\uD1A0\uB9C8\uD1A0\uC18C\uC2A4\uC624\uC9D5\uC5B4\uAE38\uAC8C\uB204\uB974\uBA74\uB0B4\uC6A9\uBCF4\uAE30\uC2AC\uB86F\uBD80\uC871\uC2DC\uAC04\uCD08\uACFC\uB808\uBCA8\uC885\uB8CC\uACC4\uC18D\uD50C\uB808\uC774\uC704\uD574\uC2DC\uAC04\uAD6C\uB9E4\uAC8C\uC784\uC815\uBCF4\uC9C0\uC6D0\uC0AC\uC6A9\uC790\uB370\uC774\uD130\uC800\uC7A5\uB428\uAD11\uACE0\uC77D\uAE30\uC2E4\uD328\uB85C\uB529\uC911\uC644\uB8CC!!!\uC694\uB9AC1\uAC1C\uB9CC\uB0A8\uC74C\uC7AC\uB8CC\uAC00\uBC29\uD0ED\uD558\uC5EC\uC120\uD0DD\uACE0\uAC1D\uC694\uB9AC\uB9CC\uB4E4\uAE30\uC704\uD574\uC7AC\uB8CC\uD558\uB098\uB354\uC120\uD0DD\uC77C\uBD80\uAC00\uBC29\uC544\uC9C1\uC5BC\uC74C...\uC77C\uBD80\uAC00\uBC29\uC544\uC9C1\uC5BC\uC74C...\uACE0\uAC1D\uC11C\uBE59\uB418\uBA74\uD574\uB3D9!\uBD10?\uC774\uB807\uAC8C\uBD80\uC11C\uC9C0\uAE30\uC2DC\uC791\uD574\uC74C...\uC774\uAC00\uBC29\uC548\uC774\uC544\uC9C1\uC548\uBCF4\uC5EC.\uC800\uAE30!\uC774\uC81C\uC548\uC774\uBCF4\uC774\uB124.\uC774\uC81C\uC790\uBB3C\uC1E0\uC640\uC5F4\uC1E0\uC788\uB294\uAC00\uBC29-\uC5F4\uC1E0\uC788\uB294\uAC00\uBC29\uBA3C\uC800\uC120\uD0DD!\uC5F4\uC1E0\uC788\uB294\uAC00\uBC29\uBA3C\uC800\uC120\uD0DD\uD544\uC694\uC790\uBB3C\uC1E0\uC788\uB294\uAC00\uBC29\uC774\uB807\uAC8C\uC5F4\uB9BC\uC138\uC77C\uD0C0\uC784!\uC77C\uBD80\uAC00\uBC29\uC774\uC81C\uCF64\uBCF4-\uD0ED\uD574\uC11C\uC7A1\uC544!\uC774\uAC83\uB4E4\uD568\uAED8-\uBE48\uC811\uC2DC\uCDA9\uBD84\uD788\uC788\uB294\uC9C0\uD655\uC778!\uC774\uC81C\uBC14\uAD6C\uB2C8\uC788\uACE0,\uAC00\uBC29\uB4E4\uC5B4\uC640!\uC774\uAC70\uC120\uD0DD\uD558\uC790!\uCEE8\uBCA0\uC774\uC5B4\uBCA8\uD2B8\uB3CC\uC544!\uC7AC\uB8CC\uAC00\uBC29\uD558\uB098\uC529\uB5A8\uC5B4\uC838-\uC9C0\uAE08\uC774\uAC00\uBC29\uC7A1\uC544!VIP\uC694\uB9AC\uAC00\uC654\uC5B4\uC694!\uC18D\uB3C4\uB97C\uB192\uC5EC\uC918\uC694!\uACE7\uCD9C\uC2DC\uCF64\uBCF4\uC0C8\uB85C\uC6B4\uC5EC\uC815\uD574\uC544\uBC14\uD0C0\uC800\uC7A5\uACC4\uC18D\uACE0\uAC1D\uC11E\uAE30\uC790\uC11D\uC0C8\uB85C\uACE0\uCE68\uB300\uAE30\uC911\uC778\uBAA8\uB4E0\uACE0\uAC1D\uC11E\uAE30\uACE0\uAC1D\uC74C\uC2DD\uC790\uB3D9\uC218\uC9D1\uBC14\uAD6C\uB2C8\uBAA8\uB4E0\uAC83\uC0C8\uB85C\uACE0\uCE68\uBD80\uC2A4\uD130\uAD6C\uB9E4\uBB34\uB8CC\uC694\uB9AC\uD558\uB098\uBC1B\uAE30?!\uC11C\uBE59\u66F4\u5FEB\uD558\uAC8C\uC694\uB9AC\uC2AC\uB86F\uD574\uC81C\uC138\uC77C60%\uD55C\uBC88\uB9CC!VIP\uB9CC\uB8CC\uC9C0\uAE08\uC7AC\uD65C\uC131\uD654\uD558\uC5EC\uD61C\uD0DD\uACC4\uC18D\uC288\uD37C\uD558\uB4DC\uB808\uBCA8\uD558\uB4DC\uB808\uBCA8\uC624\u2026\uBE48\uC811\uC2DC\uC5C6\uC74C!\uC624\uC774\uB7F0\u2026\uC2DC\uAC04\uCD08\uACFC!\uB808\uBCA8\uC644\uB8CC\uC5B4\uB824\uC6C0\uC288\uD37C\uD558\uB4DC\uC77C\uC77C\uC791\uC5C5\uAD11\uACE0\uC81C\uAC70\uC800\uAE08\uD1B5\uB7ED\uD0A4\uC2A4\uD540\uB808\uBCA8{level}\uC5D0\uC11C\uD574\uC81C\uB354\uB9CE\uC740\uBAA9\uC228\uBAA9\uC228\uC774\uB2E4\uB410\uC5B4\uC694\uB2E4\uC74C\uBAA9\uC228\uAE4C\uC9C0\uC2DC\uAC04\uBC1B\uAE30\uB9AC\uD544\uCF54\uC778\uBD80\uC871\uBAA9\uC228\uC774\uAC00\uB4DD\uCC28\uC9C0\uC54A\uC74C\uB808\uBCA8\uC2E4\uD328\uBCF4\uC0C1\uFF1A\uB2E4\uC2DC\uC2DC\uB3C4\uC77C\uC77C\uD018\uC2A4\uD2B8\uC77C\uC77C\uC791\uC5C5\uD018\uC2A4\uD2B8\uC791\uC5C5\uC218\uB839\uAC00\uAE30\uC0C8\uC694\uB9AC!\uC2E0\uADDC\uC774\uB3D9\uD69F\uC218\uCD08\uACFC\uACC4\uC18D\uD50C\uB808\uC774\uC704\uD574\uC694\uB9AC\uBC1B\uAE30\uC5EC\uAE30\uC11C\uC9C8\uBED4\uACC4\uC18D\uB3C4\uC804!\uC77C\uC2DC\uC815\uC9C0\uB9AC\uD50C\uB808\uC774\uD648\uC800\uAE08\uD1B5\uBD80\uC218\uACE0\uBAA8\uC740\uCF54\uC778\uAC00\uC838\uAC00!\uACE7\uCD9C\uC2DC\uBCF4\uC0C1\uAD11\uACE0\uB294\uC720\uC9C0\uD558\uACE0\uAD11\uACE0\uC81C\uAC70\uC0C1\uC810\uC81C\uC548\uCD08\uBCF4\uC790\uBC88\uB4E4\uAC00\uCE58\uBC88\uB4E4\uD6CC\uB96D\uD55C\uBC88\uB4E4\uD504\uB9AC\uBBF8\uC5C4\uBC88\uB4E4\uC6B8\uD2B8\uB77C\uBC88\uB4E4\uB808\uC804\uB4DC\uBC88\uB4E4\uCD5C\uACE0\uC81C\uC548\uC77CVIP\uD328\uC2A4\uC77C\uC77C+1\uC694\uB9AC\uAD11\uACE0\uC5C6\uC74C\uCF54\uC778\uC124\uC815VIP\uD65C\uC131\uD654VIP\uC694\uB9AC2\uC2DC\uAC04\uBB34\uB8CC!\uC77C\uC77C\uBCF4\uC0C1\uC2A4\uD540VIP\uC77C\uC77CVIP\uC694\uB9AC\uD574\uC81C2\uC2DC\uAC04\uBB34\uB8CC\uB85C\uBC1B\uAE30!\uD37C\uD399\uD2B8!x2\uCF54\uC778\uC644\uB8CC\uB808\uBCA8\uAD11\uACE0\uBCF4\uAE30\uBD80\uC2A4\uD130\uC0AC\uC6A9\uD68C\uC804\uC911!!!\uACE0\uAC1D\uC11C\uBE59\uBBFF\uC744\uC218\uC5C6\uC5B4!\uB180\uB77C\uC6CC!\uC7A5\uAD00\uC774\uC57C!\uACBD"
